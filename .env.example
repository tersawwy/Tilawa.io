# Optional. Copy to .env and fill in — main.py loads it automatically.
# Without any key everything still works: --background ambient uses the
# generative animated scene.

# Real nature footage for --background ambient (free: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_key_here

# B-roll fallback for the legacy word-pop style only (free: https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_key_here
